#!/bin/bash
# knk-ops op: secret-scan. Checks the last 200000 log lines of both knk-alpha containers for the
# value of each secret file and for password/JWT-shaped text. Returns clean/HIT per secret
# name only; values are passed to grep through a file descriptor, never as arguments, and the
# logs are kept in a root-only tmpfs directory that is removed on exit.
# Runs as root via an exact no-argument sudo rule.
set -u -o pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

OP=secret-scan
SECRETS_DIR=/srv/docker/stacks/knk-alpha/secrets
SECRETS=(jwt_secret mysql_app_password mysql_root_password plugin_api_key)
CONTAINERS=(knk-alpha-api knk-alpha-mysql)
TAIL=200000

fail() { jq -cn --arg op "$OP" --arg e "$1" '{ok: false, op: $op, error: $e}'; exit 1; }

tmp="$(mktemp -d /run/knk-ops.XXXXXX)" || fail tmpdir-failed
trap 'rm -rf -- "$tmp"' EXIT

lines=()
for c in "${CONTAINERS[@]}"; do
  timeout 60 docker logs --tail "$TAIL" "$c" >"$tmp/$c.log" 2>&1 || fail "logs-unavailable:$c"
  lines+=("$c=$(wc -l <"$tmp/$c.log")")
done

# hits <grep options...>: names of the containers whose log matches. One grep over all logs,
# so a pattern file descriptor is read only once.
hits() {
  local f
  grep -l "$@" -- "$tmp"/*.log | while read -r f; do basename "$f" .log; done
}

results=()
for s in "${SECRETS[@]}"; do
  f="$SECRETS_DIR/$s"
  if [ ! -f "$f" ]; then
    results+=("$s"$'\t'missing$'\t')
    continue
  fi
  len="$(tr -d '\r\n' <"$f" | wc -c)"
  if [ "$len" -lt 8 ]; then
    results+=("$s"$'\t'too-short$'\t')
    continue
  fi
  where="$(hits -F -f <(tr -d '\r\n' <"$f"; echo) | paste -sd, -)"
  if [ -n "$where" ]; then results+=("$s"$'\t'HIT$'\t'"$where"); else results+=("$s"$'\t'clean$'\t'); fi
done

pw="$(hits -i -E 'password=|pwd=' | paste -sd, -)"
jwt="$(hits -E 'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}' | paste -sd, -)"

printf '%s\n' "${results[@]}" | jq -R -s -c --arg op "$OP" --arg tail "$TAIL" \
  --arg lines "$(printf '%s\n' "${lines[@]}")" --arg pw "$pw" --arg jwt "$jwt" '
  def verdict($w): if $w == "" then {result: "clean"} else {result: "HIT", containers: ($w | split(","))} end;
  ([split("\n")[] | select(length > 0) | split("\t")
    | {key: .[0], value: ({result: .[1]} + (if .[2] != "" then {containers: (.[2] | split(","))} else {} end))}]
   | from_entries) as $secrets
  | {password_kv: verdict($pw), jwt_like: verdict($jwt)} as $indicators
  | {ok: true, op: $op, tail_lines: ($tail | tonumber),
     lines_scanned: ([$lines | split("\n")[] | select(length > 0) | split("=") | {key: .[0], value: (.[1] | tonumber)}] | from_entries),
     secrets: $secrets, indicators: $indicators,
     verdict: (if ([$secrets[], $indicators[] | .result] | any(. == "HIT")) then "HIT"
               elif ([$secrets[] | .result] | all(. == "clean")) then "clean" else "incomplete" end)}'
