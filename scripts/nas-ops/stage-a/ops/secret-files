#!/bin/bash
# knk-ops op: secret-files. Names, owners, modes and emptiness of the knk-alpha secret files.
# Never reads file contents. Runs as root via an exact no-argument sudo rule.
set -u -o pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

OP=secret-files
DIR=/srv/docker/stacks/knk-alpha/secrets
EXPECTED='["jwt_secret","mysql_app_password","mysql_root_password","playit_secret","plugin_api_key","rcon_password"]'

fail() { jq -cn --arg op "$OP" --arg e "$1" '{ok: false, op: $op, error: $e}'; exit 1; }

[ -d "$DIR" ] || fail secrets-dir-missing
dir="$(stat --printf '%U\t%G\t%u\t%g\t%a' -- "$DIR")" || fail stat-failed
entries="$(find "$DIR" -mindepth 1 -maxdepth 1 -printf '%f\t%y\t%u\t%g\t%U\t%G\t%m\t%s\n')" || fail list-failed

jq -cn --arg op "$OP" --arg path "$DIR" --arg dir "$dir" --arg entries "$entries" --argjson expected "$EXPECTED" '
  ($dir | split("\t")) as $d
  | [$entries | split("\n")[] | select(length > 0) | split("\t")
     | {name: (if (.[0] | test("^[A-Za-z0-9._-]+$")) then .[0] else "<unprintable>" end),
        type: (if .[1] == "f" then "file" elif .[1] == "l" then "symlink" elif .[1] == "d" then "dir" else "other" end),
        owner: .[2], group: .[3], uid: (.[4] | tonumber), gid: (.[5] | tonumber),
        mode: .[6], nonempty: ((.[7] | tonumber) > 0)}] as $files
  | {ok: true, op: $op, dir: {path: $path, owner: $d[0], group: $d[1], uid: ($d[2] | tonumber), gid: ($d[3] | tonumber), mode: $d[4]},
     files: ($files | sort_by(.name)),
     missing: ($expected - [$files[].name]),
     unexpected: ([$files[].name] - $expected),
     all_private: ([$files[] | .type == "file" and .mode == "600"] | all)}'
