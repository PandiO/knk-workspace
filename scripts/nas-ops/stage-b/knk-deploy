    new_text = replace_image_line(open(COMPOSE).read(), 'knk-web-app', f'alpha-{c8}')
    _, ahash, built = build_image('knk-web-app', commit, WEB_FILES, [(None, tag)])
    result = switch_compose(new_text, f'web-{c8}', {'web': 120})
    record = {'kind': 'deploy-web', 'commit': commit, 'archive_sha256': ahash, 'images': built, **result}
    set_last(record)
    return record


def restart_minecraft(timeout=420):
    mc_flush()
    run(compose_cmd('restart', 'minecraft'), timeout=300)
    return wait_healthy('minecraft', timeout)


def plugin_started(since):
    p = run([DOCKER, 'logs', '--since', since, container('minecraft')], check=False, timeout=60)
    log = (p.stdout + p.stderr).decode('utf-8', 'replace')
    ok = 'Enabling KnightsAndKings' in log and 'Error occurred while enabling KnightsAndKings' not in log
    return ok, len(re.findall(r'\b(ERROR|SEVERE)\]', log))


def cmd_deploy_plugin(commit):
    c8 = commit[:8]
    jar = inbox_file('plugin-jar', commit)
    jhash = sha256_file(jar)
    live = os.path.join(MC_DATA, 'plugins', 'KnightsAndKings.jar')
    upd = os.path.join(MC_DATA, 'plugins', 'update')
    rel = os.path.join(RELEASES, 'plugin', c8)
    os.makedirs(rel, mode=0o700, exist_ok=True)
    shutil.copy2(jar, os.path.join(rel, 'KnightsAndKings.jar'))
    with open(os.path.join(rel, 'SOURCE.txt'), 'w') as f:
        f.write(f'knk-plugin {commit}, uploaded through knk-deploy, {now():%Y-%m-%dT%H:%M:%SZ}\n')
    snap = snapshot(f'pre-plugin-{c8}')
    bdir = os.path.join(BACKUPS, stamp() + f'-plugin-{c8}')
    os.makedirs(bdir, mode=0o700)
    before = sha256_file(live)
    shutil.copy2(live, os.path.join(bdir, 'KnightsAndKings.jar'))

    def stage(src):
        os.makedirs(upd, exist_ok=True)
        os.chown(upd, MC_UID, MC_UID)
        dst = os.path.join(upd, 'KnightsAndKings.jar')
        shutil.copyfile(src, dst)
        os.chown(dst, MC_UID, MC_UID)
        os.chmod(dst, 0o644)

    stage(jar)
    since = now().strftime('%Y-%m-%dT%H:%M:%SZ')
    try:
        health = restart_minecraft()
        ok, errors = plugin_started(since)
        if sha256_file(live) != jhash:
            raise Failed('the live jar is not the new one (plugins/update not applied)')
        if not ok:
            raise Failed('KnightsAndKings did not enable')
    except (Failed, subprocess.TimeoutExpired) as e:
        step('rollback: previous plugin jar')
        stage(os.path.join(bdir, 'KnightsAndKings.jar'))
        try:
            restart_minecraft()
        except Failed:
            pass
        raise Failed(f'{e}; rolled back to jar {before[:12]}')
    record = {'kind': 'deploy-plugin', 'commit': commit, 'jar_sha256': jhash, 'jar_before': before, 'backup': bdir,
              'snapshot': snap, 'errors_in_startup_log': errors, 'health': health}
    set_last(record)
    return record


def cmd_compose_apply(h):
    text = unredact(open(inbox_file('compose', h), encoding='utf-8').read())
    result = switch_compose(text, 'compose', {'minecraft': 420, 'api': 240})
    record = {'kind': 'compose-apply', 'upload_sha256': h, **result}
    set_last(record)
    return record


def cmd_config_apply(name, h):
    path = CONFIGS[name]
    text = unredact(open(inbox_file('config-' + name, h), encoding='utf-8').read())
    bdir = os.path.join(BACKUPS, stamp() + f'-config-{name}')
    os.makedirs(bdir, mode=0o700)
    shutil.copy2(path, os.path.join(bdir, os.path.basename(path)))
    st = os.stat(path)
    before = sha256_file(path)

    def write(content_bytes):
        tmp = path + '.knk-deploy'
        with open(tmp, 'wb') as f:
            f.write(content_bytes)
        os.chown(tmp, st.st_uid, st.st_gid)
        os.chmod(tmp, st.st_mode & 0o777)
        os.replace(tmp, path)

    write(text.encode('utf-8'))
    since = now().strftime('%Y-%m-%dT%H:%M:%SZ')
    try:
        health = restart_minecraft()
        ok, errors = plugin_started(since)
        if not ok:
            raise Failed('KnightsAndKings did not enable after the config change')
    except (Failed, subprocess.TimeoutExpired) as e:
        step('rollback: previous config')
        write(open(os.path.join(bdir, os.path.basename(path)), 'rb').read())
        try:
            restart_minecraft()
        except Failed:
            pass
        raise Failed(f'{e}; rolled back {name}')
    record = {'kind': 'config-apply', 'name': name, 'before': before, 'after': sha256_file(path), 'backup': bdir,
              'errors_in_startup_log': errors, 'health': health}
    set_last(record)
    return record


def cmd_snapshot(label):
    return {'snapshot': snapshot(label)}


def cmd_restart(service):
    if service == 'minecraft':
        return {'health': restart_minecraft()}
    run(compose_cmd('restart', service), timeout=300)
    return {'health': wait_healthy(service, 240)}


def cmd_rollback():
    if not os.path.isfile(LAST):
        raise Refused('no recorded change to roll back')
    last = json.load(open(LAST))
    kind = last.get('kind')
    if kind in ('deploy-api', 'deploy-web', 'compose-apply'):
        restore_compose(last['backup'], last['services'])
        health = [wait_healthy(s, 300) for s in last['services']]
        note = None
        if kind == 'deploy-api' and last.get('migrations_applied'):
            note = (f'the database keeps the migrations {last["migrations_applied"]}; restore it by hand if the old build '
                    f'needs that: knk-alpha-restore {last.get("snapshot")} db')
        out = {'rolled_back': kind, 'compose': sha256_file(COMPOSE), 'health': health, 'note': note}
    elif kind == 'deploy-plugin':
        upd = os.path.join(MC_DATA, 'plugins', 'update')
        os.makedirs(upd, exist_ok=True)
        dst = os.path.join(upd, 'KnightsAndKings.jar')
        shutil.copyfile(os.path.join(last['backup'], 'KnightsAndKings.jar'), dst)
        os.chown(dst, MC_UID, MC_UID)
        out = {'rolled_back': kind, 'health': restart_minecraft()}
    elif kind == 'config-apply':
        path = CONFIGS[last['name']]
        st = os.stat(path)
        shutil.copyfile(os.path.join(last['backup'], os.path.basename(path)), path)
        os.chown(path, st.st_uid, st.st_gid)
        out = {'rolled_back': kind, 'name': last['name'], 'health': restart_minecraft()}
    else:
        raise Refused(f'cannot roll back a {kind}')
    os.replace(LAST, LAST + f'.rolled-back-{stamp()}')
    return out


# ---------- entry ----------

def parse(argv):
    """Map argv to (handler, args). Raises Refused for anything not in the grammar."""
    def need(cond):
        if not cond:
            raise Refused('bad arguments')
    if not argv:
        raise Refused('no command')
    c, a = argv[0], argv[1:]
    ident = lambda s, kind: PATTERNS[kind].match(s or '') is not None
    if c in ('status', 'compose-get', 'rollback'):
        need(not a)
        return {'status': cmd_status, 'compose-get': cmd_compose_get, 'rollback': cmd_rollback}[c], []
    if c == 'config-get':
        need(len(a) == 1 and a[0] in CONFIGS)
        return cmd_config_get, a
    if c == 'logs':
        need(1 <= len(a) <= 2 and a[0] in SERVICES and (len(a) == 1 or (a[1].isdigit() and 1 <= int(a[1]) <= 180)))
        return cmd_logs, [a[0], int(a[1]) if len(a) == 2 else 30]
    if c == 'upload':
        need(len(a) == 2 and a[0] in UPLOADS and ident(a[1], UPLOADS[a[0]][0]))
        return cmd_upload, a
    if c in ('deploy-api', 'deploy-web', 'deploy-plugin'):
        need(len(a) == 1 and ident(a[0], 'commit'))
        return {'deploy-api': cmd_deploy_api, 'deploy-web': cmd_deploy_web, 'deploy-plugin': cmd_deploy_plugin}[c], a
    if c == 'compose-apply':
        need(len(a) == 1 and ident(a[0], 'sha256'))
        return cmd_compose_apply, a
    if c == 'config-apply':
        need(len(a) == 2 and a[0] in CONFIGS and ident(a[1], 'sha256'))
        return cmd_config_apply, a
    if c == 'snapshot':
        need(len(a) == 1 and ident(a[0], 'label'))
        return cmd_snapshot, a
    if c == 'restart':
        need(len(a) == 1 and a[0] in RESTARTABLE)
        return cmd_restart, a
    raise Refused('unknown command')


READ_ONLY = ('status', 'compose-get', 'config-get', 'logs')


def main(argv):
    os.umask(0o077)
    if os.geteuid() != 0:
        print(json.dumps({'ok': False, 'error': 'must run as root'}))
        return 1
    try:
        handler, args = parse(argv)
    except Refused as e:
        print(json.dumps({'ok': False, 'error': 'refused', 'reason': str(e)}))
        journal({'command': argv[0] if argv else None, 'result': 'refused', 'reason': str(e)})
        return 64
    lockf = open(LOCK, 'w')
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print(json.dumps({'ok': False, 'error': 'busy'}))
        return 75
    started = time.time()
    entry = {'command': argv[0], 'args': [x for x in argv[1:]]}
    try:
        result = handler(*args)
        out = {'ok': True, 'command': argv[0], **(result or {})}
        code = 0
    except Refused as e:
        out, code = {'ok': False, 'error': 'refused', 'reason': redact(str(e))}, 65
    except (Failed, subprocess.TimeoutExpired) as e:
        out, code = {'ok': False, 'error': 'failed', 'reason': redact(str(e))}, 1
    if argv[0] not in READ_ONLY or code != 0:
        brief = {k: v for k, v in out.items() if k not in ('compose', 'content', 'log', 'services')}
        journal({**entry, 'result': 'ok' if code == 0 else out['error'], 'seconds': round(time.time() - started), 'out': brief})
    print(json.dumps(out, indent=1, sort_keys=True, default=str))
    return code


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
