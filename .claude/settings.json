{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__claude-code-remote__add_repo",
      "mcp__claude-code-remote__register_repo_root"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/fast-check.sh\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
